{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "outDir": "_site/assets/js",
    "rootDir": "src/assets/js",
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/assets/js/**/*.ts"],
  "exclude": ["node_modules", "_site"]
}
